# Copy to profiles.yml and fill in your connection.
# profiles.yml is gitignored -- do not commit credentials.

sa_snowflake:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('ACCOUNT') }}"
      user: "{{ env_var('SA_USER') }}"
      role: "{{ env_var('ROLE') }}"

      # Keypair auth
      private_key_path: "{{ env_var('KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('PASSPHRASE') }}"

      database: "{{ env_var('DATABASE') }}"
      warehouse: "{{ env_var('WAREHOUSE') }}"
      schema: dbt_your_name
      threads: 4

upgrading_to_v2:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: # workshop account, see the training slides
      user: training_user
      role: transformer
      password: # from the training slides

      database: dbt_learn
      warehouse: transformer
      schema: # your own schema
      threads: 4
